# Supabase connection (Vite exposes VITE_-prefixed vars to the browser).
# The publishable/anon key is public-safe — Row Level Security protects the data.
# Copy this file to `.env` for local dev, and set the same vars in Render for production.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx
